# ==============================================================================
# CSA TECHNOLOGIES CO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (OPTIONAL FOR PROD / MONGODB ATLAS)
# ------------------------------------------------------------------------------
# If MONGODB_URI is provided, CSA Technologies connects via Mongoose to MongoDB Atlas.
# If omitted, it automatically persists to a zero-config local file store (data/db/).
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/csatechnologies?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# 32+ character random secret used to sign admin JWT session cookies.
JWT_SECRET=csa_technologies_production_super_secure_jwt_secret_key_2026

# Seed credentials used by `npm run seed` to provision the primary admin account.
ADMIN_EMAIL=admin@csatechnologies.co
ADMIN_PASSWORD=Admin@CSA2026!

# ------------------------------------------------------------------------------
# 3. EMAIL NOTIFICATIONS (NODEMAILER / GMAIL SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=vandanarajpoot69@gmail.com
EMAIL_PASS=your-google-app-password
CONTACT_RECIPIENT=info@csatechnologiesco.com

# ------------------------------------------------------------------------------
# 4. APP DEPLOYMENT CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://csatechnologies.co
NODE_ENV=development
